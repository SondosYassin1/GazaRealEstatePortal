@model GazaRealEstatePortal.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<div class="auth-page py-5">
  <div class="container">
    <div class="auth-card">
      <div class="row g-0">
        <!-- Image Side -->
        <div class="col-lg-5 d-none d-lg-block">
          <div class="auth-image">
            <div class="auth-image-content text-start">
              <h3 class="fw-bold mb-2">مرحباً بك مجدداً!</h3>
              <p class="mb-0 text-white-50">انضم إلى أكبر مجتمع عقاري في غزة.</p>
            </div>
          </div>
        </div>
        
        <!-- Form Side -->
        <div class="col-lg-7">
          <div class="auth-form-container">
            <div class="auth-header">
              <a asp-controller="Home" asp-action="Index" class="text-decoration-none">
                <div class="brand-icon"><i class="bi bi-buildings text-white fs-3"></i></div>
                <h2>تسجيل الدخول</h2>
              </a>
              <p>مرحباً بعودتك! يرجى إدخال بياناتك للمتابعة.</p>
            </div>
            
            <form asp-controller="Auth" asp-action="Login" method="post">
              <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-cairo fw-bold"></div>
              
              <div class="form-group-custom">
                <label asp-for="Email" class="form-label-custom">البريد الإلكتروني</label>
                <input asp-for="Email" type="email" class="form-control-custom" placeholder="أدخل بريدك الإلكتروني" required>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
              </div>
              
              <div class="form-group-custom">
                <div class="d-flex justify-content-between mb-2">
                  <label asp-for="Password" class="form-label-custom mb-0">كلمة المرور</label>
                  <a href="#" class="forgot-password-link">نسيت كلمة المرور؟</a>
                </div>
                <input asp-for="Password" type="password" class="form-control-custom" placeholder="أدخل كلمة المرور" required>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
              </div>
              
              <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input">
                <label asp-for="RememberMe" class="form-check-label remember-me-label">
                  تذكرني على هذا الجهاز
                </label>
              </div>
              
              <button type="submit" class="btn-primary-custom w-100 justify-content-center btn-auth-submit">
                تسجيل الدخول <i class="bi bi-box-arrow-in-right"></i>
              </button>
            </form>
            
            <div class="divider">أو الدخول بواسطة</div>
            
            <div class="social-login">
              <a asp-controller="Auth" asp-action="ExternalLogin" asp-route-provider="Google" class="btn-social text-decoration-none text-dark">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="18px" height="18px">
                  <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
                  <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
                  <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
                  <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/>
                </svg>
                جوجل
              </a>
            </div>
            
            <p class="text-center mt-4 mb-0 auth-footer-text">
              ليس لديك حساب؟ <a asp-controller="Auth" asp-action="Register" class="text-primary-custom fw-bold">إنشاء حساب جديد</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
